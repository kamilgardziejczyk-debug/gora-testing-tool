<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Scenario report - {{ scenario_name }}</title>
<style>
  :root {
    color-scheme: light dark;

    --ground:      #F2F4F3;
    --surface:     #FBFCFB;
    --surface-alt: #E8ECEA;
    --line:        #D2D9D6;
    --line-strong: #B4BEBA;
    --ink:         #17201E;
    --ink-mid:     #4C5A56;
    --ink-soft:    #6E7B77;
    --accent:      #0E7C86;
    --accent-soft: #E0EEEF;
    --pass:        #2E7D4F;
    --pass-soft:   #E2EDE6;
    --fail:        #B3402F;
    --fail-soft:   #F5E5E2;

    --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --font-mono: ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, "Liberation Mono", monospace;

    --s1: 0.25rem; --s2: 0.5rem; --s3: 0.75rem; --s4: 1rem;
    --s5: 1.5rem; --s6: 2rem; --s7: 3rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ground:      #131817;
      --surface:     #1A2120;
      --surface-alt: #222A29;
      --line:        #2E3836;
      --line-strong: #435050;
      --ink:         #E3EAE8;
      --ink-mid:     #A6B3AF;
      --ink-soft:    #7C8985;
      --accent:      #4FBDC6;
      --accent-soft: #16302F;
      --pass:        #5FB981;
      --pass-soft:   #172C20;
      --fail:        #E0705C;
      --fail-soft:   #2E1A17;
    }
  }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  .shell { max-width: 1300px; margin: 0 auto; padding: var(--s5) var(--s4) var(--s7); }

  code, .mono { font-family: var(--font-mono); font-variant-ligatures: none; }
  .num { font-variant-numeric: tabular-nums; }

  code {
    font-size: 0.86em;
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.08em 0.32em;
    word-break: break-word;
  }

  a { color: var(--accent); }

  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

  /* ---------- masthead ---------- */

  .masthead {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    padding-bottom: var(--s4);
    border-bottom: 2px solid var(--ink);
    margin-bottom: var(--s5);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .masthead h1 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    font-weight: 650;
    letter-spacing: -0.022em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .masthead-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s5);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  .masthead-meta b { color: var(--ink-mid); font-weight: 500; }

  /* ---------- tally ---------- */

  .tally {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: var(--s4);
    margin-bottom: var(--s5);
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    max-width: 26rem;
  }

  .tally-figure { display: flex; align-items: baseline; gap: var(--s2); font-family: var(--font-mono); }
  .tally-figure .big { font-size: 1.85rem; font-weight: 600; letter-spacing: -0.03em; }
  .tally-figure .of { color: var(--ink-soft); font-size: 0.85rem; }
  .tally-figure .big[data-verdict="pass"] { color: var(--pass); }
  .tally-figure .big[data-verdict="fail"] { color: var(--fail); }

  .meter { height: 5px; background: var(--surface-alt); border-radius: 3px; overflow: hidden; }
  .meter > i { display: block; height: 100%; background: var(--pass); border-radius: 3px; }
  .meter > i[data-verdict="fail"] { background: var(--fail); }

  .tally-note { font-size: 0.78rem; color: var(--ink-soft); font-family: var(--font-mono); }

  /* ---------- results table ---------- */

  .table-wrap {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  table { border-collapse: collapse; width: 100%; min-width: 46rem; }

  th, td {
    padding: var(--s3) var(--s4);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  tbody tr:last-child td { border-bottom: 0; }

  th {
    background: var(--surface-alt);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  tbody tr.failed { background: var(--fail-soft); }

  /* Group heading rows: a full-width band naming the !Group the rows under it
     came from, with that group's own tally on the right. */
  tbody tr.group-head > td {
    background: var(--surface-alt);
    border-bottom: 1px solid var(--line-strong);
    border-top: 1px solid var(--line-strong);
    padding: var(--s2) var(--s4);
  }
  tbody tr.group-head:first-child > td { border-top: 0; }

  .group-head-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s2) var(--s4);
  }

  .group-name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mid);
  }

  .group-tally {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }
  .group-tally[data-verdict="pass"] { color: var(--pass); }
  .group-tally[data-verdict="fail"] { color: var(--fail); font-weight: 600; }

  .test-name { font-weight: 650; }
  .duration { text-align: right; white-space: nowrap; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .muted { color: var(--ink-soft); }

  .validation { display: flex; flex-direction: column; gap: var(--s1); font-size: 0.85rem; color: var(--ink-mid); }
  .validation .k {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  details > summary { cursor: pointer; }
  details > summary::marker { color: var(--ink-soft); }

  /* A tag is one identifier: breaking `!ProgramEsptool` across two lines to
     save a few pixels costs more scanning than the width it wins back, so the
     Tag column is sized to hold the longest tag whole. `code` sets
     word-break: break-word for payloads and expressions, which is right there
     and wrong here. */
  td details > summary code { white-space: nowrap; }

  pre {
    margin: var(--s2) 0 0;
    padding: var(--s3);
    background: var(--ground);
    border: 1px solid var(--line);
    border-radius: 5px;
    white-space: pre-wrap;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-mid);
  }
  pre code { background: none; border: 0; padding: 0; font-size: inherit; }

  .chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 3px;
    padding: 0.15em 0.5em;
    white-space: nowrap;
  }
  .chip-pass { color: var(--pass); background: var(--pass-soft); }
  .chip-fail { color: var(--fail); background: var(--fail-soft); }

  .error {
    margin-top: var(--s2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    white-space: pre-wrap;
    color: var(--fail);
  }

  /* ---------- colophon ---------- */

  .colophon {
    margin-top: var(--s5);
    padding-top: var(--s4);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .colophon b { color: var(--ink-mid); font-weight: 500; }
</style>
</head>
<body>
<div class="shell">
  <header class="masthead">
    <span class="eyebrow">scenario run</span>
    <h1>{{ scenario_name }}</h1>
    <div class="masthead-meta">
      <span>executed <b>{{ started_at }}</b></span>
      <span>elapsed <b class="num">{{ "%.2f"|format(total_duration_s) }} s</b></span>
      <span>checks <b class="num">{{ results|length }}</b></span>
      {% if log_files %}
        <span>logs
          {% for label, filename in log_files %}<a href="{{ filename }}">{{ label }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}
        </span>
      {% endif %}
    </div>
  </header>

  {% set total = results|length %}
  <div class="tally">
    <div class="tally-figure">
      <span class="big num" data-verdict="{{ 'fail' if failed_count else 'pass' }}">{{ passed_count }}</span>
      <span class="of num">/ {{ total }} passed</span>
    </div>
    <div class="meter">
      <i data-verdict="{{ 'fail' if failed_count else 'pass' }}"
         style="width:{{ "%.1f"|format(100.0 * passed_count / total if total else 0) }}%"></i>
    </div>
    <div class="tally-note">
      {% if failed_count %}{{ failed_count }} failed{% else %}all checks passed{% endif %}
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Test name</th>
          <th>Tag</th>
          <th>Validation</th>
          <th class="duration">Time (s)</th>
          <th>Result</th>
        </tr>
      </thead>
      <tbody>
        {% for section in sections %}
        {% if section.name is not none %}
        <tr class="group-head">
          <td colspan="5">
            <div class="group-head-inner">
              <span class="group-name">{{ section.name }}</span>
              <span class="group-tally num"
                    data-verdict="{{ 'fail' if section.passed_count < section.total_count else 'pass' }}">
                {{ section.passed_count }}/{{ section.total_count }} passed
              </span>
            </div>
          </td>
        </tr>
        {% endif %}
        {% for result in section.results %}
        <tr{% if not result.passed %} class="failed"{% endif %}>
          <td class="test-name">{{ result.name }}</td>
          <td>
            <details>
              <summary><code>!{{ result.tag }}</code></summary>
              <pre><code>{{ result.raw_yaml }}</code></pre>
            </details>
          </td>
          <td>
            {% if result.validation_expected is not none %}
              <div class="validation">
                <span><span class="k">expected</span> <code>{{ result.validation_expected }}</code></span>
                <span><span class="k">received</span> <code>{{ result.validation_actual }}</code></span>
              </div>
            {% else %}
              <span class="muted">&ndash;</span>
            {% endif %}
          </td>
          <td class="duration">{{ "%.2f"|format(result.duration_s) }}</td>
          <td>
            {% if result.passed %}
              <span class="chip chip-pass">pass</span>
            {% else %}
              <span class="chip chip-fail">fail</span>
              {% if result.error %}<div class="error">{{ result.error }}</div>{% endif %}
            {% endif %}
          </td>
        </tr>
        {% endfor %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  <footer class="colophon">
    Total execution time <b class="num">{{ "%.2f"|format(total_duration_s) }} s</b>
    &nbsp;&middot;&nbsp; <b class="num">{{ passed_count }}</b> passed,
    <b class="num">{{ failed_count }}</b> failed
  </footer>
</div>
</body>
</html>
